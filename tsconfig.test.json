{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "mocha",
      "vscode"
    ],
    "noEmit": false,
    "outDir": "out"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "dist",
    "out",
    "static",
    "scripts",
    "webviewsrc"
  ]
}
