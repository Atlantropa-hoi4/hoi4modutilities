{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "dist",
    "out",
    "static",
    "scripts"
  ]
}
