{
  "name": "hoi4modutilities",
  "displayName": "%hoi4modutilities.displayName%",
  "description": "Utilities for Heart of Iron IV mods developers",
  "version": "0.13.7",
  "author": "server (forked from Chaofan Yang)",
  "publisher": "server",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atlantropa-hoi4/hoi4modutilities"
  },
  "bugs": {
    "url": "https://github.com/Atlantropa-hoi4/hoi4modutilities/issues"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "mod",
    "paradox",
    "hoi",
    "Heart of Iron"
  ],
  "activationEvents": [
    "onWebviewPanel:server.hoi4ftpreview",
    "onWebviewPanel:server.hoi4worldmappreview",
    "workspaceContains:**/*.gfx",
    "workspaceContains:history/countries/*.txt",
    "workspaceContains:history/**/*.txt",
    "workspaceContains:interface/*.gui",
    "workspaceContains:interface/**/*.gui",
    "workspaceContains:interface/*.gfx",
    "workspaceContains:interface/**/*.gfx",
    "workspaceContains:common/**/*.txt",
    "workspaceContains:common/national_focus/*.txt",
    "workspaceContains:common/technologies/*.txt",
    "workspaceContains:events/*.txt",
    "workspaceContains:events/**/*.txt",
    "workspaceContains:country_metadata/**/*.txt",
    "workspaceContains:map/default.map"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": [
      {
        "title": "%hoi4modutilities.displayName%",
        "properties": {
          "hoi4ModUtilities.installPath": {
            "title": "%hoi4modutilities.installPath.title%",
            "type": "string",
            "default": "",
            "description": "%hoi4modutilities.installPath.desc%"
          },
          "hoi4ModUtilities.loadDlcContents": {
            "title": "%hoi4modutilities.loadDlcContents.title%",
            "type": "boolean",
            "default": true,
            "description": "%hoi4modutilities.loadDlcContents.desc%"
          },
          "hoi4ModUtilities.modFile": {
            "title": "%hoi4modutilities.modFile.title%",
            "type": "string",
            "default": "",
            "description": "%hoi4modutilities.modFile.desc%"
          },
          "hoi4ModUtilities.enableSupplyArea": {
            "title": "%hoi4modutilities.enableSupplyArea.title%",
            "type": "boolean",
            "default": false,
            "description": "%hoi4modutilities.enableSupplyArea.desc%"
          },
          "hoi4ModUtilities.previewLocalisation": {
            "title": "%hoi4modutilities.previewLocalisation.title%",
            "type": "string",
            "default": "English",
            "enum": [
              "Brazilian Portuguese",
              "English",
              "French",
              "German",
              "Korean",
              "Japanese",
              "Polish",
              "Russian",
              "Simplified Chinese",
              "Spanish"
            ],
            "description": "%hoi4modutilities.previewLocalisation.desc%"
          },
          "hoi4ModUtilities.featureFlags": {
            "title": "%hoi4modutilities.featureFlags.title%",
            "type": "array",
            "default": [],
            "description": "%hoi4modutilities.featureFlags.desc%"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "server.hoi4modutilities.preview",
        "title": "%hoi4modutilities.preview.title%",
        "icon": {
          "dark": "static/preview-right-dark.svg",
          "light": "static/preview-right-light.svg"
        },
        "enablement": "isFileSystemResource && server.shouldShowHoi4Preview",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.selectmodfile",
        "title": "%hoi4modutilities.selectmodfile.title%",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.previewworld",
        "title": "%hoi4modutilities.previewworld.title%",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.scanreferences",
        "title": "%hoi4modutilities.scanreferences.title%",
        "icon": "$(references)",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.generateFocusGfxShine",
        "title": "%hoi4modutilities.generateFocusGfxShine.title%",
        "icon": "$(sparkle)",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.resizeFlags",
        "title": "%hoi4modutilities.resizeFlags.title%",
        "icon": "$(symbol-color)",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.selecthoifolder",
        "title": "%hoi4modutilities.selecthoifolder.title%",
        "category": "%hoi4modutilities.category%"
      },
      {
        "command": "server.hoi4modutilities.test",
        "title": "HOI4 test",
        "category": "%hoi4modutilities.category%"
      }
    ],
    "customEditors": [
      {
        "viewType": "server.hoi4modutilities.dds",
        "displayName": "%hoi4modutilities.dds.editorName%",
        "selector": [
          {
            "filenamePattern": "*.dds"
          }
        ]
      },
      {
        "viewType": "server.hoi4modutilities.tga",
        "displayName": "%hoi4modutilities.tga.editorName%",
        "selector": [
          {
            "filenamePattern": "*.tga"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "server.hoi4modutilities.preview",
          "when": "server.shouldShowHoi4PreviewTitle",
          "group": "navigation"
        },
        {
          "command": "server.hoi4modutilities.generateFocusGfxShine",
          "when": "isFileSystemResource && server.shouldShowFocusGfxShine",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "server.hoi4modutilities.preview",
          "when": "isFileSystemResource && server.shouldShowHoi4Preview",
          "group": "1_preview@1"
        },
        {
          "command": "server.hoi4modutilities.previewworld",
          "group": "1_preview@2"
        },
        {
          "command": "server.hoi4modutilities.generateFocusGfxShine",
          "when": "server.shouldShowFocusGfxShine",
          "group": "2_tools@1"
        },
        {
          "command": "server.hoi4modutilities.resizeFlags",
          "group": "2_tools@2"
        },
        {
          "command": "server.hoi4modutilities.scanreferences",
          "when": "!server.hoi4MULoaded || server.hoi4PreviewType == event",
          "group": "2_tools@3"
        },
        {
          "command": "server.hoi4modutilities.selectmodfile",
          "group": "3_setup@1"
        },
        {
          "command": "server.hoi4modutilities.selecthoifolder",
          "group": "3_setup@2"
        },
        {
          "command": "server.hoi4modutilities.test",
          "when": "server.hoi4MUInDev",
          "group": "9_dev@1"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs all",
    "clean:build": "node ./scripts/clean.mjs build",
    "clean:out": "node ./scripts/clean.mjs out",
    "clean:test-ui": "rimraf .vscode-test",
    "build": "node ./scripts/build.mjs --mode=production",
    "build:dev": "node ./scripts/build.mjs --mode=development",
    "build:watch": "node ./scripts/build.mjs --mode=development --watch",
    "check-types:extension": "tsc -p ./tsconfig.extension.json --pretty false --noEmit",
    "check-types:webview": "tsc -p ./tsconfig.webview.json --pretty false --noEmit",
    "compile-ts": "npm run check-types:extension && npm run check-types:webview",
    "compile-tests": "npm run clean:out && tsc -p ./tsconfig.test.json --pretty false",
    "watch": "node ./scripts/watch.mjs",
    "watch:bundle": "npm run build:watch",
    "watch:typecheck:extension": "tsc -p ./tsconfig.extension.json --pretty false --noEmit --watch",
    "watch:typecheck:webview": "tsc -p ./tsconfig.webview.json --pretty false --noEmit --watch",
    "vscode:prepublish": "npm run build",
    "lint": "eslint src webviewsrc test --ext .ts",
    "test:unit": "npm run compile-tests && mocha --exit --recursive \"out/test/unit/**/*.test.js\"",
    "test": "npm run compile-ts && npm run build && npm run lint && npm run test:unit",
    "test-ui": "npm run compile-ts && npm run build && npm run compile-tests && vscode-test --config .vscode-test.mjs",
    "package": "vsce package --no-dependencies",
    "verify": "npm run test && npm run test-ui && npm run package"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.3",
    "eslint": "^8.57.1",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@vscode/extension-telemetry": "^1.5.1",
    "adm-zip": "^0.5.16",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "pngjs": "^7.0.0",
    "rxjs": "^7.8.2",
    "tga": "^1.0.7",
    "tslib": "^2.8.1"
  }
}
